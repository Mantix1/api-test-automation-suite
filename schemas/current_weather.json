{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "current_weather.json",
  "title": "GET /data/2.5/weather (200)",
  "type": "object",
  "required": ["coord", "weather", "main", "wind", "clouds", "dt", "sys", "timezone", "id", "name", "cod"],
  "properties": {
    "coord": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "weather": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/condition"}
    },
    "base": {"type": "string"},
    "main": {
      "type": "object",
      "required": ["temp", "feels_like", "temp_min", "temp_max", "pressure", "humidity"],
      "properties": {
        "temp": {"type": "number"},
        "feels_like": {"type": "number"},
        "temp_min": {"type": "number"},
        "temp_max": {"type": "number"},
        "pressure": {"type": "integer", "minimum": 0},
        "humidity": {"type": "integer", "minimum": 0, "maximum": 100},
        "sea_level": {"type": "integer", "minimum": 0},
        "grnd_level": {"type": "integer", "minimum": 0}
      }
    },
    "visibility": {"type": "integer", "minimum": 0},
    "wind": {
      "type": "object",
      "required": ["speed", "deg"],
      "properties": {
        "speed": {"type": "number", "minimum": 0},
        "deg": {"type": "number", "minimum": 0, "maximum": 360},
        "gust": {"type": "number", "minimum": 0}
      }
    },
    "clouds": {
      "type": "object",
      "required": ["all"],
      "properties": {
        "all": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "dt": {"type": "integer"},
    "sys": {
      "type": "object",
      "properties": {
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "sunrise": {"type": "integer"},
        "sunset": {"type": "integer"}
      }
    },
    "timezone": {"type": "integer"},
    "id": {"type": "integer"},
    "name": {"type": "string"},
    "cod": {"type": "integer", "const": 200}
  },
  "definitions": {
    "condition": {
      "type": "object",
      "required": ["id", "main", "description", "icon"],
      "properties": {
        "id": {"type": "integer"},
        "main": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "icon": {"type": "string", "pattern": "^[0-9]{2}[dn]$"}
      }
    }
  }
}
