  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "TC-FUN-01 Weather by city",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is application/json; charset=utf-8\", () => {",
                  "    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");",
                  "});",
                  "pm.test(\"Body matches current_weather.json\", () => {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"schemaCurrentWeather\")));",
                  "});",
                  "pm.test(\"City is London, GB\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.name).to.eql(\"London\");",
                  "    pm.expect(body.sys.country).to.eql(\"GB\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/weather?q=London,GB"
          }
        },
        {
          "name": "TC-FUN-02 Weather by coordinates",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body matches current_weather.json\", () => {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"schemaCurrentWeather\")));",
                  "});",
                  "pm.test(\"Coordinates are near the request\", () => {",
                  "    const coord = pm.response.json().coord;",
                  "    pm.expect(coord.lat).to.be.closeTo(51.5074, 0.1);",
                  "    pm.expect(coord.lon).to.be.closeTo(-0.1278, 0.1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/weather?lat=51.5074&lon=-0.1278&units=metric"
          }
        },
        {
          "name": "TC-FUN-03 Forecast with cnt=5",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is application/json; charset=utf-8\", () => {",
                  "    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");",
                  "});",
                  "pm.test(\"Body matches forecast.json\", () => {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"schemaForecast\")));",
                  "});",
                  "pm.test(\"Returns 5 entries, 3 hours apart\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.cnt).to.eql(5);",
                  "    pm.expect(body.list).to.have.lengthOf(5);",
                  "    for (let i = 1; i < body.list.length; i++) {",
                  "        pm.expect(body.list[i].dt - body.list[i - 1].dt).to.eql(10800);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/forecast?q=Tokyo,JP&cnt=5"
          }
        },
        {
          "name": "TC-FUN-04 Geocode Paris,FR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is application/json; charset=utf-8\", () => {",
                  "    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");",
                  "});",
                  "pm.test(\"Body matches geocoding_direct.json\", () => {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"schemaGeocodingDirect\")));",
                  "});",
                  "pm.test(\"One result: Paris, FR\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.lengthOf(1);",
                  "    pm.expect(body[0].name).to.eql(\"Paris\");",
                  "    pm.expect(body[0].country).to.eql(\"FR\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{geoBaseUrl}}/direct?q=Paris,FR&limit=1"
          }
        },
