      "value": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"$id\":\"forecast.json\",\"title\":\"GET /data/2.5/forecast (200)\",\"type\":\"object\",\"required\":[\"cod\",\"cnt\",\"list\",\"city\"],\"properties\":{\"cod\":{\"type\":\"string\",\"const\":\"200\"},\"message\":{\"type\":\"number\"},\"cnt\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":40},\"list\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":40,\"items\":{\"$ref\":\"#/definitions/entry\"}},\"city\":{\"type\":\"object\",\"required\":[\"id\",\"name\",\"coord\",\"country\",\"timezone\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"coord\":{\"type\":\"object\",\"required\":[\"lat\",\"lon\"],\"properties\":{\"lat\":{\"type\":\"number\",\"minimum\":-90,\"maximum\":90},\"lon\":{\"type\":\"number\",\"minimum\":-180,\"maximum\":180}}},\"country\":{\"type\":\"string\",\"pattern\":\"^[A-Z]{2}$\"},\"population\":{\"type\":\"integer\",\"minimum\":0},\"timezone\":{\"type\":\"integer\"},\"sunrise\":{\"type\":\"integer\"},\"sunset\":{\"type\":\"integer\"}}}},\"definitions\":{\"entry\":{\"type\":\"object\",\"required\":[\"dt\",\"main\",\"weather\",\"clouds\",\"wind\",\"pop\",\"sys\",\"dt_txt\"],\"properties\":{\"dt\":{\"type\":\"integer\"},\"main\":{\"type\":\"object\",\"required\":[\"temp\",\"feels_like\",\"temp_min\",\"temp_max\",\"pressure\",\"humidity\"],\"properties\":{\"temp\":{\"type\":\"number\"},\"feels_like\":{\"type\":\"number\"},\"temp_min\":{\"type\":\"number\"},\"temp_max\":{\"type\":\"number\"},\"pressure\":{\"type\":\"integer\",\"minimum\":0},\"humidity\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100}}},\"weather\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"object\",\"required\":[\"id\",\"main\",\"description\",\"icon\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"main\":{\"type\":\"string\",\"minLength\":1},\"description\":{\"type\":\"string\",\"minLength\":1},\"icon\":{\"type\":\"string\",\"pattern\":\"^[0-9]{2}[dn]$\"}}}},\"clouds\":{\"type\":\"object\",\"required\":[\"all\"],\"properties\":{\"all\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100}}},\"wind\":{\"type\":\"object\",\"required\":[\"speed\",\"deg\"],\"properties\":{\"speed\":{\"type\":\"number\",\"minimum\":0},\"deg\":{\"type\":\"number\",\"minimum\":0,\"maximum\":360},\"gust\":{\"type\":\"number\",\"minimum\":0}}},\"visibility\":{\"type\":\"integer\",\"minimum\":0},\"pop\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1},\"sys\":{\"type\":\"object\",\"required\":[\"pod\"],\"properties\":{\"pod\":{\"type\":\"string\",\"enum\":[\"d\",\"n\"]}}},\"dt_txt\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2}$\"}}}}}"
